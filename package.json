{
  "name": "@agentshouse/kit",
  "version": "0.2.1",
  "description": "Kit connects an Environment to agents.house.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentshouse/kit.git"
  },
  "type": "module",
  "bin": {
    "kit": "dist/kit-main.js",
    "house": "dist/house-main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bootstrap-manifest": "node scripts/bootstrap-manifest.mjs",
    "build": "tsc -p tsconfig.build.json",
    "engine": "mkdir -p tmp/engine && docker run --rm -v \"$PWD:/kit\" -w /kit alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 sh scripts/engine.sh tmp/engine",
    "follow-skills-and-kit-wire": "node scripts/follow-skills-and-kit-wire.mjs",
    "release-files": "node scripts/release-files.mjs",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@agentshouse/kit-wire": "0.1.0-caa55b2516c5d",
    "@agentshouse/mdmodel": "0.1.0-cd6a8e5bc7efc",
    "@agentshouse/session-content": "0.1.0-c560e48c9bea3",
    "@agentshouse/skills": "0.1.0-c902d35e4a6a0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "micromark": "4.0.2",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.100.0",
    "@agentclientprotocol/codex-acp": "2.5.0"
  },
  "peerDependenciesMeta": {
    "@agentclientprotocol/claude-agent-acp": {
      "optional": true
    },
    "@agentclientprotocol/codex-acp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  }
}
